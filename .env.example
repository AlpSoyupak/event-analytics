DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/event_analytics
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/event_analytics
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EVENTS_TOPIC=events
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
ENVIRONMENT=development
